# Copy this file to .env and fill in real values. Never commit .env.
# Variables prefixed EXPO_PUBLIC_ are bundled into the app and visible to anyone
# who inspects it — only put values here that are safe to be public.

# Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Sentry → Project Settings → Client Keys (DSN). Leave blank to disable.
EXPO_PUBLIC_SENTRY_DSN=

# PostHog → Project Settings → Project API Key. Leave blank to disable.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Deferred to Phase 5+ ──────────────────────────────────────────────────────
# These packages need native code that Expo Go does not include, so they are NOT
# installed yet. They will be added (with their keys below) once we can use a
# development build. See "The Expo Go rule" in CLAUDE.md.
#   - react-native-maps               (family map)       → Google Maps API key
#   - react-native-purchases          (RevenueCat)       → RevenueCat public SDK keys
#   - react-native-google-mobile-ads  (dormant ads)      → AdMob app IDs
